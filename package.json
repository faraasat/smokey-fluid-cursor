{
  "name": "smokey-fluid-cursor",
  "version": "1.0.7",
  "description": "A customizable fluid cursor effect for Vanilla JavaScript/TypeScript applications running on the web. Enhance user experience with smooth, interactive cursor animations. Perfect for modern web designs.",
  "keywords": [
    "smokey cursor",
    "fluid cursor",
    "animated cursor",
    "smokey fluid",
    "javascript",
    "typescript",
    "animated smoke cursor"
  ],
  "homepage": "https://faraasat.github.io/smokey-fluid-cursor",
  "bugs": {
    "url": "https://github.com/faraasat/smokey-fluid-cursor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/smokey-fluid-cursor.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./iife": "./dist/index.global.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && npm run test -- --run && npm run build",
    "example:dev": "npm run build && npm --prefix example install && npm --prefix example run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.55.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
